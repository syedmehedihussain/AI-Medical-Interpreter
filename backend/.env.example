# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Which translation provider to use: stub | google
# Stage 1 runs entirely on "stub", which needs no API key and makes no
# network calls. Switch to "google" in Stage 2.
TRANSLATION_PROVIDER=stub

# Google Cloud Translation v2 API key.
# Leave blank while using the stub provider. A missing key does not stop
# the server starting; it only means the google provider is not ready.
GOOGLE_TRANSLATE_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS).
# The Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173

# How long to wait on the upstream translation provider before giving up.
REQUEST_TIMEOUT_SECONDS=15
