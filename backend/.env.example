# Copy this file to .env and fill in real values:
#   cp .env.example .env          (Windows: copy .env.example .env)
#
# .env is gitignored and must never be committed. This file is committed and
# must never contain a real key.

# Which translation provider to use: stub | google_free | mymemory | google
#
#   stub         No network, no key. Echoes "[bn] <text>". For working
#                offline or on the UI without spending quota.
#   google_free  The default. Real Google translation, no key. Undocumented
#                endpoint with no service guarantee; development only.
#   mymemory     No key. A translation memory, so quality varies wildly: it
#                returned Romanised Bangla and even Hindi on common phrases.
#                Kept only to demonstrate the provider seam. See D-017.
#   google       Cloud Translation v2. Best quality, and what the deployed
#                build should use. Needs the key below and a Google Cloud
#                project with billing enabled.
#
# Default is google_free so a fresh clone translates correctly with no setup.
TRANSLATION_PROVIDER=google_free

# Google Cloud Translation v2 API key. Only read when TRANSLATION_PROVIDER
# is "google". Leave blank otherwise: a missing key never stops the server
# starting, it only makes GET /api/health report provider_ready: false.
GOOGLE_TRANSLATE_API_KEY=

# Which provider serves GET /api/speech, used only when the browser has no
# local voice for the target language (docs/decisions.md D-016).
#   google_translate  No key. Undocumented endpoint, no service guarantee.
# Google Cloud Text-to-Speech slots in here as one more option once a key
# exists, and is what the deployed build should use.
TTS_PROVIDER=google_translate

# Comma-separated list of origins allowed to call this API (CORS).
# The Vite dev server runs on 5173. Add the deployed frontend URL here
# when deploying, with no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173

# Seconds to wait on the upstream translation provider before giving up.
REQUEST_TIMEOUT_SECONDS=15
