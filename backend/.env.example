# Copy this file to .env and fill in real values:
#   cp .env.example .env          (Windows: copy .env.example .env)
#
# .env is gitignored and must never be committed. This file is committed and
# must never contain a real key.

# Which translation provider to use: stub | mymemory | google
#
#   stub      No network, no key. Echoes your text back as "[bn] <text>".
#             Useful for working on the app offline or without a quota.
#   mymemory  Real translation, no key, no signup. Roughly 5000 characters
#             per day. Quality is uneven on short phrases. Development only.
#   google    Real translation, best quality. Needs the key below, which
#             needs a Google Cloud project with billing enabled.
#
# Development default is mymemory, so a fresh clone translates for real
# with no setup. See docs/decisions.md D-014.
TRANSLATION_PROVIDER=mymemory

# Google Cloud Translation v2 API key. Only read when TRANSLATION_PROVIDER
# is "google". Leave blank otherwise: a missing key never stops the server
# starting, it only makes GET /api/health report provider_ready: false.
GOOGLE_TRANSLATE_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS).
# The Vite dev server runs on 5173. Add the deployed frontend URL here
# when deploying, with no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173

# Seconds to wait on the upstream translation provider before giving up.
REQUEST_TIMEOUT_SECONDS=15
